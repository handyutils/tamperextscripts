{
  "manifest_version": 3,
  "name": "tamperextscripts",
  "version": "0.1.0",
  "description": "Userscript manager and ChatGPT exporter. Install your own scripts or community scripts.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "userScripts"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "138",
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "tamperextscripts"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
